<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 锁屏后后台转写不被压住(vivo 真机 2026-10-29):用户点了才申请,见 MainActivity.askBackground -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- largeHeap:识别模型约 1GB,留点余量
         usesCleartextTraffic:自用版连电脑上的转录机走 Tailscale 内网 http;公开版只走 https(build.gradle 里分) -->
    <application
        android:label="转录机"
        android:icon="@mipmap/ic_launcher"
        android:largeHeap="true"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="${cleartext}"
        android:theme="@style/Theme.Zlj">

        <!-- configChanges:折叠屏开合不重建界面,字幕不闪 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 别的 App(系统录音机、微信、文件管理)里对音频点「分享」→ 转录机 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>
        </activity>

        <!-- 桌面一键录音的透明跳板:单独一个任务,不把主界面带出来。
             不导出:不然别的 App 也能悄悄让它开麦(快捷方式和小组件是以本 App 身份启动的,不需要导出) -->
        <activity
            android:name=".QuickRecord"
            android:exported="false"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@style/Theme.Zlj.Invisible" />

        <receiver
            android:name=".RecordWidget"
            android:exported="false"
            android:label="@string/sc_record">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_record_info" />
        </receiver>

        <activity
            android:name=".WebActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density" />

        <!-- 导出录音:把 cacheDir/export 里的副本分享给别的 App -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".RecordService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <service
            android:name=".WorkService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
